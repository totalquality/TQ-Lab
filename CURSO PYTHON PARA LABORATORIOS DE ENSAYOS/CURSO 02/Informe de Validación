    campos_identificacion = [
        ("Nombre del laboratorio", "laboratorio_nombre"),
        ("Área", "laboratorio_area"),
        ("Dirección", "laboratorio_direccion"),
        ("Código del laboratorio", "laboratorio_codigo"),
        ("Nombre del método", "metodo_nombre"),
        ("Código del método", "metodo_codigo"),
        ("Versión del método", "metodo_version"),
        ("Analito / mensurando", "analito"),
        ("Matriz", "matriz"),
        ("Técnica", "tecnica"),
        ("Unidad", "unidad_resultado"),
        ("Rango inferior", "rango_desde"),
        ("Rango superior", "rango_hasta"),
        ("Unidad del rango", "unidad_rango"),
    ]
    agregar_tabla(doc, ["Campo", "Información"], [
        (etiqueta, datos_generales.get(clave)) for etiqueta, clave in campos_identificacion
    ])

    # 3. Personal y responsabilidades
    agregar_titulo(doc, "3. Responsables y personal participante", nivel=1)
    agregar_tabla(doc, ["Responsabilidad", "Nombre"], [
        ("Responsable técnico", datos_generales.get("responsable_tecnico")),
        ("Elaborado por", datos_generales.get("elaborado_por")),
        ("Revisado por", datos_generales.get("revisado_por")),
        ("Aprobado por", datos_generales.get("aprobado_por")),
    ])
    for nombre_hoja, encabezados, filas in registros:
        if "analista" in nombre_hoja.lower() or "personal" in nombre_hoja.lower():
            agregar_titulo(doc, nombre_legible(nombre_hoja), nivel=2)
            agregar_tabla(doc, encabezados, filas)

    # 4. Equipos, calibraciones, MRC, reactivos y referencias
    agregar_titulo(doc, "4. Recursos y trazabilidad documental", nivel=1)
    for nombre_hoja, encabezados, filas in registros:
        if any(x in nombre_hoja.lower() for x in ["equipo", "calibr", "mrc", "reactivo", "referencia"]):
            agregar_titulo(doc, nombre_legible(nombre_hoja), nivel=2)
            agregar_tabla(doc, encabezados, filas)

    # 5. Criterios de aceptación
    agregar_titulo(doc, "5. Criterios de aceptación documentados", nivel=1)
    criterios_encontrados = False
    for nombre_hoja, encabezados, filas in registros:
        if "criterio" in nombre_hoja.lower():
            criterios_encontrados = True
            agregar_tabla(doc, encabezados, filas)
    if not criterios_encontrados:
        doc.add_paragraph(
            "No se encontró una hoja de criterios en el archivo base. "
            "Verifique que los criterios de aceptación estén documentados y aprobados."
        )

    # 6. Resultados estadísticos exportados por los módulos
    doc.add_page_break()
    agregar_titulo(doc, "6. Resultados de los estudios de validación", nivel=1)
    doc.add_paragraph(
        f"Se localizaron {len(archivos_json)} archivo(s) JSON en la carpeta de trabajo. "
        "Los datos que siguen se transcriben desde dichos archivos; el generador no recalcula "
        "estadísticos ni modifica criterios. Las imágenes se insertan desde la carpeta de gráficas seleccionada al iniciar."
    )
    imagenes_disponibles = [
        p for p in CARPETA_GRAFICAS.rglob("*")
        if p.is_file() and p.suffix.lower() in {".png", ".jpg", ".jpeg"}
    ] if CARPETA_GRAFICAS is not None and CARPETA_GRAFICAS.exists() else []
    if not imagenes_disponibles:
        aviso = doc.add_paragraph()
        aviso.add_run("AVISO: No se encontraron imágenes PNG. ").bold = True
        aviso.add_run(
            "Ejecute los módulos de análisis para guardar las gráficas y seleccione la carpeta que las contiene."
        )

    for i, ruta_json in enumerate(archivos_json, start=1):
        try:
            agregar_json_al_informe(doc, ruta_json, i, archivos_json)
        except Exception as exc:
            agregar_titulo(doc, f"{i}. {ruta_json.name}", nivel=1)
            doc.add_paragraph(
                f"No fue posible interpretar este JSON: {exc}. "
                "Revise el archivo fuente antes de emitir el informe."
            )

    # 7. Disponibilidad y pendientes
    doc.add_page_break()
    agregar_titulo(doc, "7. Disponibilidad documental y aspectos por revisar", nivel=1)
    agregar_tabla(doc, ["Elemento", "Estado"], [
        ("Archivo base", f"Leído: {ruta_excel.name}"),
        ("Archivos JSON encontrados", len(archivos_json)),
        ("Carpeta de gráficas", f"{len(imagenes_disponibles)} imagen(es) encontradas en: {CARPETA_GRAFICAS if CARPETA_GRAFICAS else 'No seleccionada'}"),
        ("Archivos JSON procesados", "Revisar las secciones del capítulo 6 y los mensajes de ejecución."),
        ("Conclusión final de validación", "Debe ser revisada y aprobada por el responsable técnico; no se infiere automáticamente."),
    ])
    doc.add_paragraph(
        "Antes de aprobar el informe, confirme que los estudios requeridos para el alcance definido "
        "estén completos, que los criterios hayan sido establecidos previamente y que las desviaciones, "
        "resultados no conformes y evaluaciones pendientes estén documentados."
    )

    # 8. Firmas
    agregar_titulo(doc, "8. Revisión y aprobación", nivel=1)
    agregar_tabla(doc, ["Actividad", "Nombre", "Firma / constancia"], [
        ("Elaboración", datos_generales.get("elaborado_por"), ""),
        ("Revisión", datos_generales.get("revisado_por"), ""),
        ("Aprobación", datos_generales.get("aprobado_por"), ""),
    ])

    salida = CARPETA_TRABAJO / NOMBRE_WORD
    agregar_numero_pagina(doc)
    doc.save(salida)

    print("=" * 72)
    print("INFORME WORD GENERADO")
    print(f"Archivo base: {ruta_excel}")
    print(f"JSON encontrados: {len(archivos_json)}")
    print(f"Salida: {salida}")
    print("=" * 72)
    print("Importante: revise el informe y sus conclusiones antes de aprobarlo.")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"\nERROR: {error}")
        sys.exit(1)
